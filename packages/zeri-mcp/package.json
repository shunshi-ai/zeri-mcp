{
  "name": "shunshi-zeri-mcp",
  "version": "0.1.0",
  "description": "MCP server for 择日 (Chinese date selection) — find auspicious dates for weddings, moving, business opening, groundbreaking and contracts, from the real 黄历. Powered by Shunshi.AI.",
  "type": "module",
  "bin": {
    "shunshi-zeri-mcp": "./dist/stdio.js"
  },
  "main": "./dist/mcp.js",
  "types": "./dist/mcp.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/stdio.js",
    "dev": "tsx src/stdio.ts",
    "smoke": "tsx tests/smoke-stdio.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zeri",
    "择日",
    "擇日",
    "date-selection",
    "auspicious-date",
    "wedding-date",
    "黄历",
    "老黄历",
    "almanac",
    "chinese-almanac",
    "吉日",
    "宜忌",
    "日取り",
    "택일",
    "길일",
    "shunshi",
    "shunshi.ai",
    "顺时"
  ],
  "author": "Shunshi.AI (https://shunshi.ai)",
  "license": "MIT",
  "homepage": "https://github.com/shunshi-ai/zeri-mcp/tree/main/packages/zeri-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shunshi-ai/zeri-mcp.git",
    "directory": "packages/zeri-mcp"
  },
  "bugs": {
    "url": "https://github.com/shunshi-ai/zeri-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "shunshi-zeri-core": "^0.1.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
